# ── Main bot (required) ───────────────────────────────────────────────
DISCORD_TOKEN=your_main_bot_token_here
CLIENT_ID=your_application_id_here

# Register slash commands to this guild only. Omit for global registration.
GUILD_ID=your_guild_id_here

# ── Extra music instances ─────────────────────────────────────────────
# One bot account per voice channel. Non-secret settings (name, guildId,
# voiceChannelId, apiPort) live in config.json; tokens belong here.
# Falls back to config.json botToken if unset.
MUSIC1_TOKEN=
MUSIC2_TOKEN=
MUSIC3_TOKEN=

# ── Spotify (required for spotify links) ──────────────────────────────
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Control API ───────────────────────────────────────────────────────
# Main bot listens here; instances use MUSIC_API_PORT+1, +2, +3.
MUSIC_API_PORT=8000

# Bearer token for the control API. If unset the API is UNAUTHENTICATED —
# and docker-compose uses network_mode: host, so it binds the host directly.
MUSIC_API_KEY=generate_a_long_random_string

# ── Shantha relay ─────────────────────────────────────────────────────
# Outbound WebSocket tunnel so Shantha can reach this bot without
# inbound ports. Both are required for the relay to connect.
SHANTHA_RELAY_URL=ws://your-shantha-host:3001/relay/zyra
ZYRA_RELAY_SECRET=must_match_shantha_ZYRA_RELAY_SECRET

# ── Now-playing panel ─────────────────────────────────────────────────
# Channel the main bot posts its player panel to. Falls back to the
# queue's originating text channel when unset.
MAIN_PANEL_CHANNEL_ID=

# ── Logging (optional) ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_TO_FILE=1
LOG_DIR=
RUNTIME_LOGGER_DISABLED=
NO_COLOR=
